# Copy this file to  .streamlit/secrets.toml  and fill in real values.
# The real secrets.toml is git-ignored - never commit it.
#
# On Streamlit Community Cloud, paste these same keys into
# App settings -> Secrets (do NOT upload the file).

WEATHERLINK_API_KEY = "your-weatherlink-v2-api-key"
WEATHERLINK_API_SECRET = "your-weatherlink-v2-api-secret"
GEMINI_API_KEY = "your-google-gemini-api-key"

# Optional: skip the /stations lookup by pinning the station id.
# WEATHERLINK_STATION_ID = "123456"
